{
  "openapi": "3.1.0",
  "info": {
    "title": "AINRA registrar — public door + read API",
    "version": "1",
    "description": "A registrar-box's HTTP surface. READ endpoints are open. The PUBLIC DEMO DOOR (POST /demo/issue, /demo/revoke, /demo/link, /demo/link/revoke) needs no token, is rate-limited, staging/TEST-ROOT only, and mints/revokes only a low-tier specimen — so a stranger completes the whole lifecycle safely. Operator writes (/issue,/renew,/revoke) require a bearer token (see the console spec). There is NO verify REST API: GET /present returns the signed bundle and you verify it LOCALLY."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4907",
      "description": "local staging registrar (make stage-all)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness + network/root labels + record count.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/accreditation": {
      "get": {
        "summary": "issuer_key + log_root_key + status_key (verification anchors).",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/present": {
      "get": {
        "summary": "Signed presentation bundle for a subject at ?now= (feed to @ainra/sdk to verify LOCALLY).",
        "parameters": [
          {
            "name": "sub",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "now",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "unknown subject"
          }
        }
      }
    },
    "/record": {
      "get": {
        "summary": "The stored issued record for a subject.",
        "parameters": [
          {
            "name": "sub",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "unknown subject"
          }
        }
      }
    },
    "/export": {
      "get": {
        "summary": "Full record export at ?now=.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/status-list": {
      "get": {
        "summary": "Current signed status list segment at ?now=.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/links": {
      "get": {
        "summary": "The whole link index with inclusion proofs (D-078) — fetched whole; there is no lookup by key.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/decision-heads": {
      "get": {
        "summary": "Every logged decision head (D-081), each with its inclusion proof under one checkpoint — fetched whole.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/decision-head": {
      "post": {
        "summary": "Log a gate's signed decision head (D-081). Open: the statement authenticates itself. A gate's head never goes backwards here. Answers a receipt — the statement, its leaf and an inclusion proof under a signed checkpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "statement",
                  "gate_key"
                ],
                "properties": {
                  "statement": {
                    "type": "string",
                    "description": "the canonical head statement line, exactly as the gate signed it"
                  },
                  "gate_key": {
                    "type": "string",
                    "description": "the gate's Ed25519 public key, base64url"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HeadReceipt"
          },
          "400": {
            "description": "not a canonical statement signed by that key / a head below or replacing one already logged"
          },
          "429": {
            "description": "rate limited"
          }
        }
      }
    },
    "/demo/issue": {
      "post": {
        "summary": "PUBLIC DOOR: mint a low-tier specimen:demo credential (no auth, rate-limited, staging only).",
        "responses": {
          "200": {
            "description": "IssuedRecord"
          },
          "403": {
            "description": "not staging"
          },
          "429": {
            "description": "rate limited"
          }
        }
      }
    },
    "/demo/link": {
      "post": {
        "summary": "PUBLIC DOOR: link a key the visitor's agent holds to a demo specimen (no auth, rate-limited, staging only). The key's own signature over the consent bytes is required, as on /link.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "passport",
                  "key",
                  "pop",
                  "nbf",
                  "exp"
                ],
                "properties": {
                  "passport": {
                    "type": "string"
                  },
                  "alg": {
                    "type": "string",
                    "enum": [
                      "Ed25519",
                      "ES256K"
                    ],
                    "default": "Ed25519"
                  },
                  "key": {
                    "type": "string",
                    "description": "the public key, base64url: 32-byte Ed25519, or the 33-byte compressed secp256k1 point for ES256K"
                  },
                  "pop": {
                    "type": "string",
                    "description": "the key's 64-byte signature over the link consent bytes, in its own algorithm (ES256K: r || s, low-S), base64url"
                  },
                  "scope": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "nbf": {
                    "type": "integer"
                  },
                  "exp": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LinkRecord"
          },
          "400": {
            "description": "bad spec / proof of control fails"
          },
          "403": {
            "description": "not a demo specimen / not staging"
          },
          "429": {
            "description": "rate limited"
          }
        }
      }
    },
    "/demo/link/revoke": {
      "post": {
        "summary": "PUBLIC DOOR: revoke a link to a demo specimen (no auth, rate-limited, staging only).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "thumbprint",
                  "kind"
                ],
                "properties": {
                  "thumbprint": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "link",
                      "operator",
                      "compromise"
                    ]
                  },
                  "suspect_since": {
                    "type": "integer"
                  },
                  "now": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LinkRevocation"
          },
          "403": {
            "description": "not a link to a demo specimen / not staging"
          },
          "429": {
            "description": "rate limited"
          }
        }
      }
    },
    "/demo/revoke": {
      "post": {
        "summary": "PUBLIC DOOR: revoke a specimen this registrar minted (no auth, rate-limited, staging only).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sub"
                ],
                "properties": {
                  "sub": {
                    "type": "string"
                  },
                  "now": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "revoked"
          },
          "403": {
            "description": "not a demo specimen / not staging"
          },
          "429": {
            "description": "rate limited"
          }
        }
      }
    }
  }
}
